# ============ StrategyLab environment ============
# Copy to .env and fill in real values. NEVER commit .env.

APP_ENV=development

# --- Database ---
# Local dev fallback (no infra needed):
DATABASE_URL=sqlite+aiosqlite:///./strategylab.db
# Docker / production (TimescaleDB):
# DATABASE_URL=postgresql+asyncpg://strategylab:strategylab@localhost:5432/strategylab

POSTGRES_USER=strategylab
POSTGRES_PASSWORD=strategylab
POSTGRES_DB=strategylab

# --- Cache / queues (Phase 2+) ---
REDIS_URL=

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# --- Market data provider: demo | dhan (Phase 2) ---
MARKET_DATA_PROVIDER=demo

DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
