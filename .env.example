# ============ StrategyLab environment ============
# Copy to .env and fill in real values. NEVER commit .env.

APP_ENV=development

# --- CORS ---
# Browser origins allowed to call the API, comma-separated. Add the exact origin
# (scheme://host:port) of the web app - a different port or a LAN IP will not
# work unless it is listed here. The effective list is returned by
# GET /api/v1/health as "allowed_origins" to make a mismatch diagnosable.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# Local dev fallback (no infra needed):
DATABASE_URL=sqlite+aiosqlite:///./strategylab.db
# Docker / production (TimescaleDB):
# DATABASE_URL=postgresql+asyncpg://strategylab:strategylab@localhost:5432/strategylab

POSTGRES_USER=strategylab
POSTGRES_PASSWORD=strategylab
POSTGRES_DB=strategylab

# --- Cache / queues (Phase 2+) ---
REDIS_URL=

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# --- Market data provider: demo | dhan ---
MARKET_DATA_PROVIDER=demo

# --- Broker credentials ---
# Read by _broker_config() and passed to each gateway on every order, funds and
# position call. The variable names are <BROKER>_<FIELD>, where <BROKER> is the
# uppercase broker name: DHAN, ZERODHA, UPSTOX, ANGELONE, FYERS, ICICI, 5PAISA.
#
# Fields: CLIENT_ID (Dhan/Upstox/Angel One), API_KEY (Zerodha/Fyers/Upstox/
# Angel One), ACCESS_TOKEN (all), USER_EMAIL (5paisa). A single ACCESS_TOKEN is
# also copied to session_token, which is what ICICI reads.
#
# Credentials never reach a gateway unless these are set - an unconfigured broker
# sends an empty token and the broker rejects the call.
#
# Dhan: web.dhan.co > Settings > API Keys. Access tokens are daily, so it must be
# regenerated each trading day.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

UPSTOX_API_KEY=
UPSTOX_ACCESS_TOKEN=

ANGELONE_API_KEY=
ANGELONE_ACCESS_TOKEN=

FYERS_API_KEY=
FYERS_ACCESS_TOKEN=

ICICI_ACCESS_TOKEN=

5PAISA_ACCESS_TOKEN=
5PAISA_USER_EMAIL=

# --- AI Builder: any OpenAI-compatible API. Empty -> deterministic rule-based parser ---
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Alerts: Telegram bot and/or generic webhook. Both empty -> notifications off ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

# --- Background scheduler (auto-ticks running forward tests) ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SEC=60

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
